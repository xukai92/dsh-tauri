{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.1",
  "identifier": "ai.deepseek.harness",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop client",
    "longDescription": "Native macOS shell for the DeepSeek Harness Web GUI (dsh --profile web).",
    "externalBin": ["../binaries/dsh-web", "../binaries/dsh-web-spawn-helper", "../binaries/dsh-web-rg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "signingIdentity": "-"
    }
  }
}
