# Rust build output
src-tauri/target/

# Tauri-generated schemas (regenerated by tauri-build on every cargo build)
src-tauri/gen/schemas/

# Sidecar build artifacts (built by scripts/build-tauri-sidecar.ts, then bundled).
# The sharp-libs directory is a Tauri resource whose path must always exist, so
# keep its .gitkeep while ignoring the built exe and the emitted libvips files.
binaries/*
!binaries/sharp-libs/
binaries/sharp-libs/*
!binaries/sharp-libs/.gitkeep
.dsh-web-staging/
